# .env.example
# Copy this file to .env and fill in real values.
#
# Get Telegram bot tokens from @BotFather: https://t.me/BotFather

# ── Bot 1 ───────────────────────────────────────────────────────────────────────
BOT1_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT1_PORT=8081

# ── Bot 2 ───────────────────────────────────────────────────────────────────────
BOT2_TOKEN=987654321:BByyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
BOT2_PORT=8082

# ── Bot 3 (uncomment when adding bot-3 to docker-compose.yml) ──────────────────
# BOT3_TOKEN=111222333:CCzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
# BOT3_PORT=8083

# ── Optional per-bot tuning (can also be set inside docker-compose.yml) ─────────
# FEED_URL=https://habr.com/ru/rss/hub/infosecurity/all/?fl=ru
# MAX_ARTICLES=10
# ARTICLE_EXPIRY_HOURS=24
