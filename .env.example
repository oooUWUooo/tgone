# Copy to .env and fill in real values from @BotFather

# ── Bot 1 ──────────────────────────────────────────────────────────────────
BOT1_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT1_PORT=8081

# ── Bot 2 ──────────────────────────────────────────────────────────────────
BOT2_TOKEN=987654321:BByyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
BOT2_PORT=8082

# ── Optional per-instance tuning ───────────────────────────────────────────
# MAX_ARTICLES=20            # articles fetched per hub (default 20)
# CACHE_TTL_MINUTES=5        # feed cache TTL in minutes (default 5)
# POLL_INTERVAL_MINUTES=15   # background poll interval (default 15)
# ARTICLE_EXPIRY_HOURS=24    # how long to remember sent articles (default 24)
# DATA_FILE=subscriptions.json  # subscription persistence path
